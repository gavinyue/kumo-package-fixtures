{
  "id": "wordpress",
  "version": "7.1.3-kumo.2",
  "name": "WordPress",
  "category": "CMS",
  "description": "Build and customize a WordPress site with its own MySQL database and file storage.",
  "repository": "https://github.com/WordPress/WordPress",
  "ref": "fc9832bef919c2a08541248db23af90d14ffb082",
  "license": "GPL-2.0-or-later",
  "template": "wordpress",
  "settings": {
    "dockerfile": "Dockerfile",
    "port": 8080,
    "healthPath": "/_kumo/ready.php",
    "resources": {
      "database": {
        "type": "mysql",
        "branch": "copy",
        "idleSeconds": 300,
        "memoryMb": 512
      }
    },
    "bindings": {
      "WORDPRESS_DB_HOST": "database.host",
      "WORDPRESS_DB_USER": "database.user",
      "WORDPRESS_DB_PASSWORD": "database.password",
      "WORDPRESS_DB_NAME": "database.name"
    },
    "config": {
      "WORDPRESS_CONFIG_EXTRA": "define('DISALLOW_FILE_MODS', true); define('WP_HOME', 'http://' . ($_SERVER['HTTP_HOST'] ?? 'localhost')); define('WP_SITEURL', WP_HOME);"
    },
    "volume": {
      "mountPath": "/var/www/html/wp-content/uploads",
      "uid": 33,
      "gid": 33
    },
    "runtime": {
      "memoryMb": 384,
      "capabilities": [
        "CHOWN",
        "SETUID",
        "SETGID",
        "DAC_OVERRIDE"
      ]
    },
    "development": {
      "editablePaths": [
        "extensions"
      ],
      "protectedPaths": [
        "_kumo",
        "wp-admin",
        "wp-includes",
        "Dockerfile",
        ".dockerignore",
        "kumobuild.json"
      ]
    }
  },
  "apiVersion": "kumo.app/v1",
  "publisher": "kumobuild",
  "capabilities": {
    "branch": "snapshot",
    "upgrade": "manual"
  },
  "connections": [
    {
      "protocol": "http",
      "auth": "basic",
      "tools": [
        {
          "name": "posts_list",
          "description": "List published posts in this WordPress instance.",
          "method": "GET",
          "path": "/index.php",
          "constants": {
            "per_page": "10"
          },
          "query": {
            "rest_route": "/wp/v2/posts"
          }
        },
        {
          "name": "create_draft",
          "description": "Create a draft post. Never publishes a post.",
          "method": "POST",
          "path": "/index.php",
          "parameters": {
            "title": {
              "type": "string",
              "required": true,
              "maxLength": 200
            },
            "content": {
              "type": "string",
              "maxLength": 10000
            }
          },
          "constants": {
            "status": "draft"
          },
          "query": {
            "rest_route": "/wp/v2/posts"
          }
        },
        {
          "name": "drafts_list",
          "description": "List this connection's own draft posts. Read-only; drafts are never published.",
          "method": "GET",
          "path": "/index.php",
          "constants": {
            "per_page": "20",
            "status": "draft",
            "context": "edit"
          },
          "query": {
            "rest_route": "/wp/v2/posts"
          }
        }
      ]
    }
  ],
  "initialization": "wordpress"
}
